{
  "functions": {
    "api/rpc.js": {
      "maxDuration": 30
    },
    "api/upload.js": {
      "maxDuration": 30
    },
    "api/launches.js": {
      "maxDuration": 30
    },
    "api/launch.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.(js|css|html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}